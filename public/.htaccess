<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Execute API scripts directly
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^api/(.*)$ api/$1 [QSA,L]

  # Pass existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other requests to index.html for React SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
